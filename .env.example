# Copy to .env and fill in. Never commit real values.
# The CLI loads .env.local then .env (first value wins); Next.js loads both too.

# OpenAI (paid key). OPENAI_MODEL is reported in the trace only via the API response's model field.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional: reasoning effort for reasoning models (minimal | low | medium). Leave blank for non-reasoning models.
OPENAI_REASONING_EFFORT=

# Supabase (public, browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://emhbqdihgbkvnaifkuno.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role: server-only (CLI mirror + API routes). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
